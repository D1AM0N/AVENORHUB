// use prisma-8

model Tenant {
  id             String    @id @onCreate(cuid(2))
  name           String
  slug           String    @unique
  currencySymbol String    @default("₦")
  taxRate        Float     @default(0)
  status         String    @default("active")
  mrrAmount      Float     @default(0)
  createdAt      DateTime  @default(now())

  users          User[]
  products       Product[]
  sales          Sale[]
  expenses       Expense[]
  roleConfigs    RoleConfig[]
  roleActivities RoleActivity[]
  auditLogs      AuditLog[]
}

model User {
  id               String   @id @onCreate(cuid(2))
  tenantId         String?
  tenant           Tenant?  @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  name             String
  email            String
  companyName      String?
  passwordHash     String
  role             String   @default("cashier")
  twoFactorEnabled Boolean  @default(false)
  lastLoginIp      String?
  createdAt        DateTime @default(now())
  roleActivities   RoleActivity[]

  @@unique([email, tenantId])
}

model Product {
  id           String   @id @onCreate(cuid(2))
  tenantId     String
  tenant       Tenant   @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  name         String
  sku          String?
  location     String?
  category     String
  sellingPrice Float
  costPrice    Float    @default(0)
  stock        Int      @default(0)
  threshold    Int      @default(5)
  createdAt    DateTime @default(now())
}

model Sale {
  id                    String   @id @onCreate(cuid(2))
  tenantId              String
  tenant                Tenant   @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  saleDate              DateTime
  channel               String
  location              String
  partnerName           String?
  quantity              Int      @default(1)
  deliveryOrPartnerCost Float    @default(0)
  amountPaid            Float
  unitPrice             Float?
  sellingPrice          Float?
  profit                Float
  status                String   @default("completed")
  createdAt             DateTime @default(now())
}

model Expense {
  id             String   @id @onCreate(cuid(2))
  tenantId       String
  tenant         Tenant   @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  expenseDate    DateTime
  description    String
  category       String
  unitsRestocked Int?
  fundingSource  String   @default("Company")
  amount         Float
  createdAt      DateTime @default(now())
}

model AuditLog {
  id         String   @id @onCreate(cuid(2))
  tenantId   String?
  tenant     Tenant?  @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  actorEmail String
  action     String
  target     String
  ipAddress  String?
  createdAt  DateTime @default(now())

  @@index([tenantId, createdAt])
}

model RoleConfig {
  id             String   @id @onCreate(cuid(2))
  tenantId       String
  tenant         Tenant   @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  roleName       String
  roleSlug       String
  modules        String[]
  activityFields String[]
  createdAt      DateTime @default(now())

  @@unique([tenantId, roleSlug])
}

model RoleActivity {
  id          String   @id @onCreate(cuid(2))
  tenantId    String
  tenant      Tenant   @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  userId      String
  user        User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  actorName   String
  roleName    String
  summary     String
  amountNaira Float    @default(0)
  metadata    Json?
  createdAt   DateTime @default(now())

  @@index([tenantId, roleName])
}